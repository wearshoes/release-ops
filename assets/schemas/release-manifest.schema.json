{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/release-manifest-v1.json",
  "title": "Release Ops public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "buildNumbers", "publishedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "release-ops/release-manifest/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "buildNumbers": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
    "publishedAt": { "type": "string", "format": "date-time" },
    "releaseUrl": { "type": "string", "pattern": "^https://github\\.com/" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "platform", "architecture", "size", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "downloadUrl": { "type": "string", "pattern": "^https://github\\.com/" },
          "platform": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "processor-graph.schema.json#/$defs/hash" }
        }
      }
    }
  }
}
