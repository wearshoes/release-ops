{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/config-v1.json",
  "title": "Release Ops project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "extensions"],
  "properties": {
    "schemaVersion": { "const": "release-ops/config/v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "extensions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/extensionInstance" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "extensionInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "extensionId", "configSchemaVersion", "config"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/id" },
        "extensionId": { "$ref": "#/$defs/id" },
        "configSchemaVersion": { "type": "string", "pattern": "^release-ops/extension-config/[a-z0-9-]+/v[1-9][0-9]*$" },
        "config": { "type": "object" }
      }
    }
  }
}
