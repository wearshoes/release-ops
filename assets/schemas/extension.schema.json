{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/extension-v1.json",
  "title": "Release Ops extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "version", "status", "configSchemaVersion", "configSchema", "docs", "dependencies", "processors", "runtimeFiles"],
  "properties": {
    "schemaVersion": { "const": "release-ops/extension/v1" },
    "id": { "$ref": "config.schema.json#/$defs/id" },
    "type": { "enum": ["stack", "signing", "release", "provider"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["supported", "credential-gated", "diagnostic"] },
    "configSchemaVersion": { "type": "string", "pattern": "^release-ops/extension-config/[a-z0-9-]+/v[1-9][0-9]*$" },
    "configSchema": { "$ref": "processor.schema.json#/$defs/path" },
    "docs": { "$ref": "processor.schema.json#/$defs/path" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "cardinality", "optional"],
        "properties": {
          "capability": { "$ref": "processor.schema.json#/$defs/capability" },
          "cardinality": { "enum": ["one", "many"] },
          "optional": { "type": "boolean" }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any", "content"],
      "properties": {
        "all": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "any": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "pattern"],
            "properties": {
              "path": { "$ref": "processor.schema.json#/$defs/path" },
              "pattern": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" },
          "type": {
            "enum": [
              "boolean", "build-units", "build-unit-selection", "github-distribution",
              "github-repository", "path", "sentry-project", "versioning"
            ]
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "targets": {
      "type": "object",
      "propertyNames": { "$ref": "config.schema.json#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/runner" }
    },
    "processors": { "type": "array", "minItems": 1, "items": { "$ref": "processor.schema.json" } },
    "runtimeFiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "processor.schema.json#/$defs/path" } }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "stack" } }, "required": ["type"] },
      "then": { "required": ["targets"] }
    }
  ],
  "$defs": {
    "runner": { "type": "string", "pattern": "^(?:ubuntu|windows|macos)-(?:latest|[0-9]+(?:\\.[0-9]+)?)$" }
  }
}
