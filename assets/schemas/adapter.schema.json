{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/adapter-v2.json",
  "title": "Release Ops adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "docs", "detects", "artifactTypes", "debugArtifactTypes", "targets"],
  "properties": {
    "schemaVersion": { "const": "release-ops/adapter/v2" },
    "id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["supported", "credential-gated", "unsupported"] },
    "docs": { "$ref": "#/$defs/repositoryPath" },
    "detects": { "$ref": "#/$defs/stringSet" },
    "artifactTypes": { "$ref": "#/$defs/stringSet" },
    "debugArtifactTypes": { "$ref": "#/$defs/stringSet" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runner"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "runner": { "$ref": "#/$defs/hostedRunner" }
        }
      }
    },
    "credentialProfiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/secretName" }
      }
    },
    "selfHostedFallback": { "type": "boolean" },
    "selfHostedConditions": { "$ref": "#/$defs/stringSet" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "repositoryPath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
    "hostedRunner": { "type": "string", "pattern": "^(ubuntu|windows|macos)-(latest|[0-9]+(?:\\.[0-9]+)?)$" },
    "secretName": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,99}$" },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
