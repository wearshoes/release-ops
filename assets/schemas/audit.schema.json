{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/audit-v1.json",
  "title": "Release Ops audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "success", "remoteVerified", "checks", "extensions"],
  "properties": {
    "schemaVersion": { "const": "release-ops/audit/v1" },
    "success": { "type": "boolean" },
    "remoteVerified": { "type": "boolean" },
    "checks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/check" } },
    "extensions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pass", "fail", "configured", "disabled", "not-applicable"] },
        "message": { "type": "string" }
      }
    }
  }
}
