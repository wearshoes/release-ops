{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/provider-v1.json",
  "title": "Release Ops Provider v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "category", "capabilities", "installed"],
  "properties": {
    "schemaVersion": { "const": "release-ops/provider/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "category": { "enum": ["observability", "performance", "vulnerability", "quality"] },
    "installed": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["configure", "audit", "requiredSecrets", "buildHooks", "scheduledIngest", "incidentIntake", "resolve"]
      }
    },
    "requiredSecrets": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,99}$" }
    }
  }
}
