{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/inspect-v1.json",
  "title": "Release Ops project inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "projectName", "config", "route", "stackCandidates", "signingIndicators", "versionSources", "git", "workflows", "installedExtensions"],
  "properties": {
    "schemaVersion": { "const": "release-ops/inspect/v1" },
    "root": { "type": "string", "minLength": 1 },
    "projectName": { "type": "string", "minLength": 1 },
    "config": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "action"],
          "properties": {
            "status": { "const": "missing" },
            "action": { "const": "initialize" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "schemaVersion", "instanceIds", "action"],
          "properties": {
            "status": { "const": "valid" },
            "schemaVersion": { "const": "release-ops/config/v1" },
            "instanceIds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "config.schema.json#/$defs/id" }
            },
            "action": { "const": "audit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "schemaVersion", "action"],
          "properties": {
            "status": { "const": "incompatible" },
            "schemaVersion": { "const": "release-ops/config/v2" },
            "action": { "const": "reinitialize" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "schemaVersion", "action", "message"],
          "properties": {
            "status": { "const": "invalid" },
            "schemaVersion": { "type": ["string", "null"] },
            "action": { "const": "reinitialize" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultCommand", "allowed", "requiredMode"],
      "properties": {
        "defaultCommand": { "enum": ["plan", "audit", "reinitialize"] },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["initialize", "audit", "reconfigure", "reinitialize"] }
        },
        "requiredMode": {
          "oneOf": [
            { "enum": ["initialize", "reinitialize"] },
            { "type": "null" }
          ]
        }
      }
    },
    "stackCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensionId", "status", "docs"],
        "properties": {
          "extensionId": { "$ref": "config.schema.json#/$defs/id" },
          "status": { "enum": ["supported", "credential-gated", "diagnostic"] },
          "docs": { "$ref": "processor.schema.json#/$defs/path" }
        }
      }
    },
    "signingIndicators": { "type": "array", "items": { "type": "string" } },
    "versionSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "file", "reader", "key", "value"],
        "properties": {
          "kind": { "enum": ["canonical", "build-number"] },
          "file": { "$ref": "processor.schema.json#/$defs/path" },
          "reader": { "enum": ["gradle-properties", "properties", "package-json", "pubspec"] },
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "branch", "head"],
      "properties": {
        "remote": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "head": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "workflows": { "type": "array", "items": { "type": "string" } },
    "installedExtensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "version", "status", "configSchemaVersion"],
        "properties": {
          "id": { "$ref": "config.schema.json#/$defs/id" },
          "type": { "enum": ["stack", "signing", "release", "provider"] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": { "enum": ["supported", "credential-gated", "diagnostic"] },
          "configSchemaVersion": {
            "type": "string",
            "pattern": "^release-ops/extension-config/[a-z0-9-]+/v[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
