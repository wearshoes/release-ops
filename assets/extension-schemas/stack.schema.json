{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wearshoes/release-ops/schemas/stack-config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "buildUnits", "versioning"],
  "properties": {
    "root": { "$ref": "#/$defs/path" },
    "buildUnits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/buildUnit" } },
    "versioning": { "$ref": "#/$defs/versioning" },
    "secretNames": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/secret" }
    },
    "application": { "$ref": "#/$defs/application" },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "secret": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,99}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
    "runner": { "type": "string", "pattern": "^(?:(ubuntu|windows|macos)-(latest|[0-9]+(?:\\.[0-9]+)?)|self-hosted)$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "nameTemplate", "contentType", "platform", "architecture"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "nameTemplate": { "type": "string", "minLength": 1 },
        "contentType": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "debugArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "buildUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "runner", "command", "requiredSecretRoles", "artifacts", "debugArtifacts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "runner": { "$ref": "#/$defs/runner" },
        "selfHostedReason": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/command" },
        "requiredSecretRoles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "debugArtifacts": { "type": "array", "items": { "$ref": "#/$defs/debugArtifact" } }
      }
    },
    "versionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "reader", "key"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "reader": { "enum": ["properties", "json", "text", "gradle-properties", "package-json", "pubspec", "godot", "unity"] },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "buildNumbers", "changelogPattern", "requiresChinese"],
      "properties": {
        "canonical": { "$ref": "#/$defs/versionSource" },
        "buildNumbers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/versionSource" } }
          }
        },
        "changelogPattern": { "$ref": "#/$defs/path" },
        "requiresChinese": { "type": "boolean" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId"],
      "properties": {
        "applicationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]+$" },
        "debugApplicationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]+$" },
        "updateManifestUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debugArtifactPath": { "$ref": "#/$defs/path" },
        "mappingPath": { "$ref": "#/$defs/path" },
        "resourceShrinkArtifacts": { "type": "array", "items": { "$ref": "#/$defs/path" } }
      }
    }
  }
}
